# STAGE 1: Build the application
# We use a Maven image that explicitly includes JDK 21 to fix the "release version 21" error.
FROM maven:3.9.6-eclipse-temurin-21 AS build

# Set the working directory inside the container
WORKDIR /app

# Copy the pom.xml first to cache dependencies
COPY pom.xml .

# Download dependencies (this step is cached if pom.xml doesn't change)
RUN mvn dependency:go-offline -B

# Copy the actual source code
COPY src ./src

# Build the application (skipping tests to save time, as seen in your logs)
RUN mvn clean package -DskipTests

# STAGE 2: Run the application
# We use a smaller runtime image (JRE 21) for the final container
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# Copy the JAR file from the build stage
# Note: We use a wildcard *.jar to match whatever your artifact is named
COPY --from=build /app/target/*.jar app.jar

# Expose the port your app runs on (usually 8080 for Spring Boot)
EXPOSE 8080

# Command to run the application
ENTRYPOINT ["java", "-jar", "app.jar"]